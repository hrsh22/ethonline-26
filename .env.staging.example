# Combined workstation-only staging integration template. Copy to .env.staging to exercise the
# demo deployment before releasing it. Never install this combined file on the VM: provision the
# isolated config/env service templates as /etc/orbit/<service>.env instead.

BASE_SEPOLIA_RPC_URL=
RPC_URL=

NEXT_PUBLIC_APP_URL=https://demo.example
NEXT_PUBLIC_API_URL=https://api.demo.example
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=staging
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

HISTORY_INDEX_URL=http://127.0.0.1:8787
HISTORY_READ_API_TOKEN=paste-generated-staging-read-credential-here
HISTORY_INGEST_API_TOKEN=paste-generated-staging-ingestion-credential-here
HISTORY_MANIFEST_PATH=deployments/84532.staging.json
HISTORY_DATABASE_PATH=.data/staging/history/history.sqlite
KEEPER_ATTEMPT_DATABASE_PATH=.data/staging/history/keeper-attempts.sqlite

PUBLIC_API_ALLOWED_ORIGINS=https://demo.example
ADMIN_AUTH_APP_ORIGIN=https://demo.example
ADMIN_AUTH_RPC_URL=
ADMIN_AUTH_MANIFEST_PATH=deployments/84532.staging.json
ADMIN_AUTH_DATABASE_PATH=.data/staging/api/admin-auth.sqlite

TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_SERVICE_URL=http://127.0.0.1:8790
TESTNET_FUNDING_ENV_PATH=.env.testnet-funding.staging
TESTNET_FUNDING_MANIFEST_PATH=deployments/84532.staging.json
TESTNET_FUNDING_DATABASE_PATH=.data/staging/funding/funding.sqlite

TESTNET_FUNDING_REPLENISH_ENV_PATH=.env.testnet-funding-treasury.staging
TESTNET_FUNDING_REPLENISH_MANIFEST_PATH=deployments/84532.staging.json
TESTNET_FUNDING_REPLENISH_DATABASE_PATH=.data/staging/replenisher/replenisher.sqlite

OPERATOR_EXECUTE=false
DEPLOYMENT_MANIFEST_PATH=deployments/84532.staging.json
HEALTH_EVIDENCE_PATH=.scratch/base-sepolia-staging-health.json
OPERATOR_EVIDENCE_PATH=.data/staging/operator/evidence.json
OPERATOR_CONTROL_HOST=127.0.0.1
OPERATOR_CONTROL_PORT=8795
OPERATOR_CONTROL_DATABASE_PATH=.data/staging/operator/control.sqlite
OPERATOR_CONTROL_URL=http://127.0.0.1:8795
OPERATOR_CONTROL_API_TOKEN=
KEEPER_ATTEMPT_OUTBOX_PATH=.data/staging/operator/keeper-attempt-outbox.sqlite

# Deployment credentials do not belong in this runtime convenience file. Use a separately
# controlled copy of config/env/deployment.env.example when publishing the staging manifest.
DEPLOYMENT_ENVIRONMENT=staging
SELF_FUNDED_TEST_ASSETS=true
