# Authoritative web-process template. Every value in this file is browser-public except the
# platform-owned process settings at the end. Never put bearer tokens or private RPC credentials
# behind NEXT_PUBLIC_. The guarded launcher rejects apps/web/.env* files; inject these values from
# the parent process or copy the local-integration subset from ../../.env.example.

# Canonical browser origin. Production builds require an HTTPS origin with no path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public HTTPS API origin in deployment; loopback HTTP is allowed locally.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8800
# staging selects deployments/84532.staging.json after that manifest is published.
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=staging
# Public ID from dashboard.privy.io. Configure email and external wallets plus every app origin.
NEXT_PUBLIC_PRIVY_APP_ID=
# The explicit RPC takes precedence over the Base Sepolia fallback.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# A hosting platform may additionally set HOSTNAME, PORT, NEXT_TELEMETRY_DISABLED, and NODE_ENV.
# The launcher passes them through, but they are process-manager settings rather than app config.
