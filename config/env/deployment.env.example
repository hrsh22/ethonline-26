# Authoritative one-shot deployment and maintenance template. Never install this file on a runtime
# host. Keep populated copies in a separately controlled deployment system and remove the deployer
# key after use. Runtime service templates are the other files in this directory.
RPC_URL=
BASE_SEPOLIA_RPC_URL=
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_MANIFEST_PATH=deployments/84532.json
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Protocol deployment safety and role assignment. Production requires explicit role addresses;
# the self-funded Base Sepolia POC may use the deployer for the operational roles.
SELF_FUNDED_TEST_ASSETS=true
FORCE_PROTOCOL_DEPLOY=false
DEPLOYMENT_VERBOSE=false
GOVERNANCE_OWNER_ADDRESS=
RECOVERY_AUTHORITY_ADDRESS=
RECOVERY_COSIGNER_ADDRESS=
GUARDIAN_ADDRESS=
KEEPER_ADDRESS=
LIQUIDITY_EXECUTOR_ADDRESS=
CREATOR_ADDRESS=
BLOCKED_VENUE_INVENTORY_PATH=deployments/84532.blocked-venues.json
VRF_NATIVE_FUNDING_WEI=

# CCA replacement deployment. The simulation and broadcast commands refuse unsafe or conflicting
# output; see the root README before using --broadcast.
CCA_DEPLOYMENT_INPUT=
CCA_MANIFEST_OUTPUT=

# Advanced one-shot evidence and governance controls.
HEALTH_EVIDENCE_PATH=.scratch/base-sepolia-health.json
SMOKE_EVIDENCE_PATH=deployments/84532-evidence.json
SMOKE_FORK=false
VERIFICATION_EVIDENCE_PATH=deployments/84532-verification.json
GOVERNANCE_SAFE_EVIDENCE_PATH=
GOVERNANCE_SAFE_SALT_NONCE=

# Standalone legacy Foundry composition/verification inputs still consumed by checked scripts.
TREASURY_ADDRESS=
CANONICAL_MARKET_REGISTRY_ADDRESS=
GENESIS_LIQUIDITY_VAULT_ADDRESS=

# Graph query credentials belong to the API template. Only this deployment credential belongs here.
GRAPH_STUDIO_DEPLOY_KEY=
