# Authoritative funding-replenisher template. Copy it to the ignored root
# .env.testnet-funding-treasury for local use, or install it as /etc/orbit/replenisher.env with mode
# 0600. The treasury key belongs only here; never add a deployer, operator, or funding-signer key.
RPC_URL=
BASE_SEPOLIA_RPC_URL=
TESTNET_FUNDING_REPLENISH_ENABLED=false

# The address is stored beside its key so a swapped key fails before moving assets. Startup also
# refuses a treasury holding any protocol role.
TESTNET_FUNDING_TREASURY_ADDRESS=
TESTNET_FUNDING_TREASURY_PRIVATE_KEY=
TESTNET_FUNDING_SIGNER_ADDRESS=
TESTNET_FUNDING_REPLENISH_MANIFEST_PATH=deployments/84532.staging.json
TESTNET_FUNDING_REPLENISH_DATABASE_PATH=/var/lib/orbit/staging/replenisher/replenisher.sqlite
TESTNET_FUNDING_REPLENISH_INTERVAL_SECONDS=300

# Top up when inventory falls below the minimum, by exactly the top-up amount, without exceeding
# the persisted daily ceiling. Each top-up must exceed its minimum and not exceed its daily limit.
TESTNET_FUNDING_REPLENISH_MINIMUM_ETH=0.02
TESTNET_FUNDING_REPLENISH_MINIMUM_WETH=0.2
TESTNET_FUNDING_REPLENISH_TOPUP_ETH=0.2
TESTNET_FUNDING_REPLENISH_TOPUP_WETH=2
TESTNET_FUNDING_REPLENISH_DAILY_ETH=0.4
TESTNET_FUNDING_REPLENISH_DAILY_WETH=4

# To load a nondefault local file, set TESTNET_FUNDING_REPLENISH_ENV_PATH in the launcher's parent
# shell. It is a launcher setting and does not belong inside this worker environment.
