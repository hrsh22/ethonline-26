# Authoritative transaction-signing operator template. Keep it owner-only (0600). The operator
# reads RPC_URL first, then BASE_SEPOLIA_RPC_URL. It never receives a deployer or funding key.
RPC_URL=
BASE_SEPOLIA_RPC_URL=
DEPLOYMENT_MANIFEST_PATH=deployments/84532.json
OPERATOR_EVIDENCE_PATH=.scratch/base-sepolia-operator.json
OPERATOR_EXECUTE=false
OPERATOR_INTERVAL_SECONDS=300
OPERATOR_MINIMUM_OUTPUT_BPS=9900

# Use OPERATOR_PRIVATE_KEY when one dedicated identity has both operational roles. Otherwise leave
# it blank and provide both role-specific keys.
OPERATOR_PRIVATE_KEY=
OPERATOR_KEEPER_PRIVATE_KEY=
OPERATOR_LIQUIDITY_EXECUTOR_PRIVATE_KEY=

# Protocol-Owned Liquidity batching policy; these values are operational, not secret.
OPERATOR_POL_MINIMUM_QUEUE_WETH=0.005
OPERATOR_POL_TARGET_WETH_PER_CYCLE=0.025
OPERATOR_POL_MAXIMUM_WETH_PER_CYCLE=0.05
OPERATOR_POL_STALE_QUEUE_SECONDS=900

# History ingestion and durable retry outbox. The token must match HISTORY_INGEST_API_TOKEN in the
# history-worker environment. HISTORY_INDEX_URL remains loopback-only.
HISTORY_INDEX_URL=http://127.0.0.1:8787
HISTORY_INGEST_API_TOKEN=
KEEPER_ATTEMPT_OUTBOX_PATH=.data/operator/base-sepolia-keeper-attempt-outbox.sqlite

# Optional loopback control plane. Either leave the whole group blank or configure every value.
# NEXT_PUBLIC_APP_URL is used server-side here as the domain for signed browser commands.
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPERATOR_CONTROL_HOST=127.0.0.1
OPERATOR_CONTROL_PORT=8795
OPERATOR_CONTROL_API_TOKEN=
OPERATOR_CONTROL_DATABASE_PATH=/var/lib/orbit/operator-control/operator-control.sqlite
