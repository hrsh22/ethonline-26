# Authoritative read-only history-worker template. Keep this file owner-only (0600): RPC and
# subgraph URLs can contain credentials, and both bearer tokens authorize private worker routes.
# RPC precedence is HISTORY_RPC_URL, RPC_URL, then BASE_SEPOLIA_RPC_URL.
HISTORY_RPC_URL=
RPC_URL=
BASE_SEPOLIA_RPC_URL=

HISTORY_MANIFEST_PATH=deployments/84532.staging.json
HISTORY_DATABASE_PATH=/var/lib/orbit/staging/history/history.sqlite
KEEPER_ATTEMPT_DATABASE_PATH=/var/lib/orbit/staging/history/keeper-attempts.sqlite
KEEPER_ATTEMPT_MAXIMUM_AGE_SECONDS=900
HISTORY_HOST=127.0.0.1
HISTORY_PORT=8787

# Generate independent canonical unpadded base64url credentials of 32-384 random bytes. The read
# token is also provisioned to the API; the ingest token is also provisioned to the operator.
HISTORY_READ_API_TOKEN=
HISTORY_INGEST_API_TOKEN=

# Advanced indexing controls. HISTORY_BATCH_BLOCKS must exceed HISTORY_REORG_OVERLAP_BLOCKS.
HISTORY_POLL_SECONDS=15
HISTORY_BATCH_BLOCKS=2000
HISTORY_CONFIRMATION_BLOCKS=2
HISTORY_REORG_OVERLAP_BLOCKS=64
HISTORY_RPC_CONCURRENCY=4
HISTORY_RETRY_MAXIMUM_ATTEMPTS=5
HISTORY_RETRY_BASE_DELAY_MILLISECONDS=250
HISTORY_MAXIMUM_PAGE_SIZE=100
HISTORY_CURSOR_SNAPSHOT_RETENTION=10000

# Optional provider-hosted Uniswap v4 candle feed. Without it, the worker derives market history
# from canonical indexed Swap events. Keep the bearer token server-side.
UNISWAP_V4_SUBGRAPH_URL=
UNISWAP_V4_SUBGRAPH_BEARER_TOKEN=
UNISWAP_V4_SUBGRAPH_TIMEOUT_MILLISECONDS=10000
UNISWAP_V4_SUBGRAPH_CACHE_SECONDS=60
