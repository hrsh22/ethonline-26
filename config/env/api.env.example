# Authoritative VM-owned public API template. This service has no signing key. Keep this file
# owner-only (0600), because it contains worker bearer tokens and may contain credentialed RPC and
# Graph query URLs. The API listener stays behind the deployment TLS reverse proxy.
PUBLIC_API_HOST=127.0.0.1
PUBLIC_API_PORT=8800
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_TRUST_PROXY=false
PUBLIC_API_UPSTREAM_TIMEOUT_MILLISECONDS=10000
PUBLIC_API_MAXIMUM_REQUEST_BODY_BYTES=2048
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_RATE_LIMIT_MAXIMUM_REQUESTS=120
PUBLIC_API_RATE_LIMIT_MAXIMUM_CLIENTS=10000

# Read-only history upstream. Generate a canonical unpadded base64url token of 32-384 random
# bytes. The same value must be provisioned as HISTORY_READ_API_TOKEN for the history worker.
HISTORY_INDEX_URL=http://127.0.0.1:8787
HISTORY_READ_API_TOKEN=

# Inventory-only funding upstream. Use at least 32 random characters. The same value must be
# provisioned as TESTNET_FUNDING_API_TOKEN for the funding worker.
TESTNET_FUNDING_SERVICE_URL=http://127.0.0.1:8790
TESTNET_FUNDING_API_TOKEN=

# Administrator authentication uses a read-only RPC and owner-only durable SQLite state. The app
# origin must also occur in PUBLIC_API_ALLOWED_ORIGINS. Deployment paths must be absolute and may
# not be root-level, in-memory, or symlinked.
ADMIN_AUTH_APP_ORIGIN=http://localhost:3000
ADMIN_AUTH_RPC_URL=
ADMIN_AUTH_MANIFEST_PATH=deployments/84532.staging.json
ADMIN_AUTH_DATABASE_PATH=/var/lib/orbit/staging/api/admin-auth.sqlite
ADMIN_AUTH_CHALLENGE_TTL_SECONDS=300
ADMIN_AUTH_SESSION_TTL_SECONDS=900

# Optional operator-control proxy. Leave both URL and token blank when there is no control plane.
# The same token must be provisioned to the operator; it never reaches the browser.
OPERATOR_CONTROL_URL=http://127.0.0.1:8795
OPERATOR_CONTROL_API_TOKEN=

# Optional Graph Studio analytics. The deploy key belongs only in deployment.env.example.
GRAPH_STUDIO_QUERY_URL=
GRAPH_API_KEY=
