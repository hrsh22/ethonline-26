# Authoritative inventory-only funding-worker template. Copy it to the ignored root
# .env.testnet-funding for local use, or install it as /etc/orbit/funding.env with mode 0600.
# Never add deployer, operator, governance, or treasury keys to this file.
RPC_URL=
BASE_SEPOLIA_RPC_URL=
TESTNET_FUNDING_ENABLED=false
TESTNET_FUNDING_SIGNER_ADDRESS=
TESTNET_FUNDING_SIGNER_PRIVATE_KEY=
# Use at least 32 random characters; provision the same value to the public API.
TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_MANIFEST_PATH=deployments/84532.json
TESTNET_FUNDING_DATABASE_PATH=.data/testnet-funding.sqlite
TESTNET_FUNDING_HOST=127.0.0.1
TESTNET_FUNDING_PORT=8790

# The wallet-control proof domain. Leave blank to derive the host from an inherited
# NEXT_PUBLIC_APP_URL; an enabled signer needs one of these values. Do not set the app URL in this
# service file because it would override the shared local-integration value.
TESTNET_FUNDING_PROOF_DOMAIN=

# To load a nondefault local file, set TESTNET_FUNDING_ENV_PATH in the launcher's parent shell. It
# is a launcher setting and does not belong inside this worker environment.
