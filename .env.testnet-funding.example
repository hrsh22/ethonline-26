# Dedicated signer-process environment. Copy to the ignored
# .env.testnet-funding; never add privileged protocol keys here.
BASE_SEPOLIA_RPC_URL=
RPC_URL=
TESTNET_FUNDING_ENABLED=false
TESTNET_FUNDING_SIGNER_ADDRESS=
TESTNET_FUNDING_SIGNER_PRIVATE_KEY=
TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_DATABASE_PATH=.data/testnet-funding.sqlite
TESTNET_FUNDING_HOST=127.0.0.1
TESTNET_FUNDING_PORT=8790
# The domain a wallet-control proof is bound to, so a proof signed for another
# site cannot be replayed here. Leave it blank to derive the host from
# NEXT_PUBLIC_APP_URL in the root environment; an enabled signer needs one.
TESTNET_FUNDING_PROOF_DOMAIN=
