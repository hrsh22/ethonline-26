{
  "name": "orbit-4444",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "api:serve": "pnpm build:packages && pnpm --filter @orbit/api build && pnpm --filter @orbit/api start",
    "backend": "pnpm build:packages && pnpm --filter @orbit/api build && node scripts/backend.ts",
    "backend:staging": "pnpm build:packages && pnpm --filter @orbit/api build && node scripts/backend.ts --profile=staging",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @orbit/config build && pnpm --filter @orbit/protocol build",
    "check": "pnpm check:ci",
    "check:ci": "pnpm format:check && pnpm --filter @orbit/config check:deployment-schema && pnpm build:packages && node scripts/generate-web-deployment-manifest.ts --check && pnpm lint && pnpm typecheck:scripts && pnpm -r --if-present typecheck",
    "check:web-deployment-manifest": "pnpm --filter @orbit/config build && node scripts/generate-web-deployment-manifest.ts --check",
    "clean:generated": "node scripts/clean-generated.ts",
    "deploy:protocol": "pnpm --filter @orbit/config build && node scripts/deploy-protocol.ts",
    "dev": "pnpm build:packages && node scripts/staging-web.ts dev",
    "dev:local": "pnpm build:packages && node scripts/staging-web.ts dev:local",
    "dev:staging": "pnpm build:packages && node scripts/staging-web.ts dev:staging",
    "format": "pnpm format:prettier && pnpm --dir packages/contracts format",
    "format:check": "pnpm format:prettier:check && pnpm --dir packages/contracts format:check",
    "format:prettier": "prettier --write \"*.{ts,json,md,yaml,yml}\" \".github/**/*.{md,yaml,yml}\" \"apps/api/**/*.{ts,json,md}\" \"apps/web/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.{md,json}\" \"packages/**/*.{ts,json,md}\" \"scripts/**/*.ts\" \"deployments/*.json\"",
    "format:prettier:check": "prettier --check \"*.{ts,json,md,yaml,yml}\" \".github/**/*.{md,yaml,yml}\" \"apps/api/**/*.{ts,json,md}\" \"apps/web/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.{md,json}\" \"packages/**/*.{ts,json,md}\" \"scripts/**/*.ts\" \"deployments/*.json\"",
    "funding:replenisher": "pnpm --filter @orbit/config build && node scripts/testnet-funding-replenisher-launcher.ts",
    "funding:worker": "pnpm --filter @orbit/config build && node scripts/testnet-funding-launcher.ts",
    "generate:web-deployment-manifest": "pnpm --filter @orbit/config build && node scripts/generate-web-deployment-manifest.ts",
    "governance:accept": "pnpm build:packages && node scripts/accept-module-governance.ts",
    "governance:safe": "pnpm build:packages && node scripts/governance-safe.ts",
    "health:base-sepolia": "pnpm build:packages && node scripts/check-base-sepolia-health.ts",
    "health:base-sepolia:staging": "pnpm build:packages && node scripts/check-base-sepolia-health.ts --profile=staging",
    "history:backfill": "pnpm build:packages && node scripts/runtime-service-launcher.ts history --once",
    "history:worker": "pnpm build:packages && node scripts/runtime-service-launcher.ts history",
    "model:genesis-curve": "pnpm build:packages && node scripts/model-genesis-curve.ts",
    "lint": "pnpm --dir apps/web lint && eslint apps/api packages scripts --max-warnings=0",
    "operator:base-sepolia": "pnpm build:packages && node scripts/runtime-service-launcher.ts operator",
    "operator:watch": "pnpm build:packages && node scripts/runtime-service-launcher.ts operator-watch",
    "test": "pnpm build:packages && pnpm test:scripts:ci && pnpm -r --if-present test && pnpm --dir apps/web test:production && pnpm test:deployment:ci",
    "test:scripts": "pnpm --filter @orbit/config build && vitest run scripts/*.test.ts scripts/*/*.test.ts",
    "test:scripts:ci": "vitest run scripts/*.test.ts scripts/*/*.test.ts",
    "test:deployment": "pnpm --filter @orbit/config build && node scripts/test-local-deployment.ts",
    "test:deployment:ci": "node scripts/test-local-deployment.ts",
    "test:deployment:base-fork": "pnpm build:packages && node scripts/test-base-sepolia-fork-deployment.ts",
    "smoke:base-sepolia": "pnpm build:packages && node scripts/smoke-base-sepolia.ts",
    "verify:sources:base-sepolia": "node scripts/verify-base-sepolia-sources.ts",
    "typecheck": "pnpm build:packages && pnpm typecheck:scripts && pnpm -r --if-present typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "wallet:smoke": "node scripts/walletconnect-smoke-wallet.ts",
    "deploy:cca-protocol": "pnpm --filter @orbit/config build && node scripts/deploy-cca-protocol.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@orbit/config": "workspace:*",
    "@orbit/protocol": "workspace:*",
    "@reown/walletkit": "1.5.6",
    "@types/node": "26.3.0",
    "@walletconnect/core": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "effect": "3.22.1",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "viem": "2.55.10",
    "vitest": "4.1.11"
  }
}
