# Dedicated replenisher environment. Copy to the ignored
# .env.testnet-funding-treasury; never add protocol or funding-signer keys here.
# This process owns no listener and answers no request: it only tops the funding
# signer up from a treasury the internet-facing worker holds no key for.
BASE_SEPOLIA_RPC_URL=
RPC_URL=
TESTNET_FUNDING_REPLENISH_ENABLED=false
# The wallet the top-ups come from, and the funding signer they go to. The
# address is configured beside its key so a swapped key fails before it moves
# anything. Startup refuses a treasury that holds any protocol role.
TESTNET_FUNDING_TREASURY_ADDRESS=
TESTNET_FUNDING_TREASURY_PRIVATE_KEY=
TESTNET_FUNDING_SIGNER_ADDRESS=
TESTNET_FUNDING_REPLENISH_DATABASE_PATH=.data/testnet-funding-replenisher.sqlite
TESTNET_FUNDING_REPLENISH_INTERVAL_SECONDS=300
# Top up when the signer falls below the minimum, by exactly the top-up amount,
# never past the daily ceiling. The ceiling is persisted, so a restart loop
# cannot walk through it. Defaults shown; each must exceed its own minimum.
TESTNET_FUNDING_REPLENISH_MINIMUM_ETH=0.02
TESTNET_FUNDING_REPLENISH_MINIMUM_WETH=0.2
TESTNET_FUNDING_REPLENISH_TOPUP_ETH=0.2
TESTNET_FUNDING_REPLENISH_TOPUP_WETH=2
TESTNET_FUNDING_REPLENISH_DAILY_ETH=0.4
TESTNET_FUNDING_REPLENISH_DAILY_WETH=4
