# Workstation-only staging funding signer. Copy to .env.testnet-funding.staging.
# On the VM, provision these values only to /etc/orbit/funding.env.
RPC_URL=
BASE_SEPOLIA_RPC_URL=
TESTNET_FUNDING_ENABLED=false
TESTNET_FUNDING_SIGNER_ADDRESS=
TESTNET_FUNDING_SIGNER_PRIVATE_KEY=
TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_MANIFEST_PATH=deployments/84532.staging.json
TESTNET_FUNDING_DATABASE_PATH=.data/staging/funding/funding.sqlite
TESTNET_FUNDING_HOST=127.0.0.1
TESTNET_FUNDING_PORT=8790
TESTNET_FUNDING_PROOF_DOMAIN=
