# Slim local-integration template. Copy to .env only when running several repository services as
# one developer. The authoritative per-process templates and advanced settings live in config/env/;
# deployments must use separate owner-only service files rather than this combined file.

# Shared Base Sepolia transport. Explicit RPC_URL takes precedence in local launchers.
BASE_SEPOLIA_RPC_URL=
RPC_URL=

# Browser-public web bindings; see config/env/web.env.example.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8800
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=staging
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# History/API/operator wiring. Generate two independent canonical unpadded base64url credentials
# of 32-384 random bytes. These placeholders are intentionally invalid.
HISTORY_INDEX_URL=http://127.0.0.1:8787
HISTORY_READ_API_TOKEN=paste-generated-read-credential-here
HISTORY_INGEST_API_TOKEN=paste-generated-ingestion-credential-here

# API and administrator-auth minimums; see config/env/api.env.example for policy knobs.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_AUTH_APP_ORIGIN=http://localhost:3000
ADMIN_AUTH_RPC_URL=
ADMIN_AUTH_MANIFEST_PATH=deployments/84532.json
ADMIN_AUTH_DATABASE_PATH=/var/lib/orbit/admin-auth/admin-auth.sqlite

# Funding worker/API wiring. The bearer value must match .env.testnet-funding, which is created
# from config/env/funding.env.example.
TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_SERVICE_URL=http://127.0.0.1:8790

# The local operator defaults to dry-run. Configure the shared token to enable its control plane;
# see config/env/operator.env.example for signing identities and policy controls.
OPERATOR_EXECUTE=false
OPERATOR_CONTROL_HOST=127.0.0.1
OPERATOR_CONTROL_PORT=8795
OPERATOR_CONTROL_DATABASE_PATH=.data/operator/operator-control.sqlite
OPERATOR_CONTROL_URL=http://127.0.0.1:8795
OPERATOR_CONTROL_API_TOKEN=

# Development-only signing fallback: pnpm backend maps this deployer key into the operator child
# only when all three flags below select the self-funded staging execute profile and no dedicated
# operator key is configured. No deployed runtime service may receive DEPLOYER_PRIVATE_KEY.
DEPLOYMENT_ENVIRONMENT=staging
SELF_FUNDED_TEST_ASSETS=true
DEPLOYER_PRIVATE_KEY=
