# Local combined-development template only. Deployed services use separate owner-only (0600)
# environment files and the exact allowlists documented in docs/operations/runtime-environments.md.
BASE_SEPOLIA_RPC_URL=
RPC_URL=
HEALTH_EVIDENCE_PATH=.scratch/base-sepolia-health.json
# Durable shared history worker. HISTORY_RPC_URL falls back to RPC_URL and BASE_SEPOLIA_RPC_URL.
HISTORY_RPC_URL=
HISTORY_MANIFEST_PATH=deployments/84532.json
HISTORY_DATABASE_PATH=.data/history/base-sepolia.sqlite
KEEPER_ATTEMPT_DATABASE_PATH=.data/history/base-sepolia-keeper-attempts.sqlite
KEEPER_ATTEMPT_MAXIMUM_AGE_SECONDS=900
KEEPER_ATTEMPT_OUTBOX_PATH=.data/operator/base-sepolia-keeper-attempt-outbox.sqlite
HISTORY_HOST=127.0.0.1
HISTORY_PORT=8787
HISTORY_INDEX_URL=http://127.0.0.1:8787
# Required independent server-only credentials: canonical unpadded base64url encodings of 32 to
# 384 random bytes. Read authorizes GET routes; ingest authorizes only Keeper-attempt POSTs. Never
# reuse either value or prefix one with NEXT_PUBLIC_. Follow docs/operations/indexed-history.md to
# generate and paste real values; these literal placeholders are intentionally invalid.
HISTORY_READ_API_TOKEN=paste-generated-read-credential-here
HISTORY_INGEST_API_TOKEN=paste-generated-ingestion-credential-here
HISTORY_POLL_SECONDS=15
# Must be greater than HISTORY_REORG_OVERLAP_BLOCKS.
HISTORY_BATCH_BLOCKS=2000
HISTORY_CONFIRMATION_BLOCKS=2
HISTORY_REORG_OVERLAP_BLOCKS=64
HISTORY_RPC_CONCURRENCY=4
HISTORY_RETRY_MAXIMUM_ATTEMPTS=5
HISTORY_RETRY_BASE_DELAY_MILLISECONDS=250
HISTORY_MAXIMUM_PAGE_SIZE=100
HISTORY_CURSOR_SNAPSHOT_RETENTION=10000
# Optional provider-hosted Uniswap v4 subgraph candle feed. Keep credentials
# server-side; the history worker validates this deployment's Pool ID and tokens
# before serving OHLC. Without it, the market uses canonical indexed Swap events.
UNISWAP_V4_SUBGRAPH_URL=
UNISWAP_V4_SUBGRAPH_BEARER_TOKEN=
UNISWAP_V4_SUBGRAPH_TIMEOUT_MILLISECONDS=10000
UNISWAP_V4_SUBGRAPH_CACHE_SECONDS=60
# Loopback-only public API behind the deployment's TLS reverse proxy.
PUBLIC_API_HOST=127.0.0.1
PUBLIC_API_PORT=8800
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_TRUST_PROXY=false
PUBLIC_API_UPSTREAM_TIMEOUT_MILLISECONDS=10000
PUBLIC_API_MAXIMUM_REQUEST_BODY_BYTES=2048
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_RATE_LIMIT_MAXIMUM_REQUESTS=120
PUBLIC_API_RATE_LIMIT_MAXIMUM_CLIENTS=10000
# VM-owned administrator authentication. The app origin must also appear in
# PUBLIC_API_ALLOWED_ORIGINS. The database is owner-only durable state; the RPC is read-only.
ADMIN_AUTH_APP_ORIGIN=http://localhost:3000
ADMIN_AUTH_RPC_URL=
ADMIN_AUTH_MANIFEST_PATH=deployments/84532.json
ADMIN_AUTH_DATABASE_PATH=/var/lib/orbit/admin-auth/admin-auth.sqlite
ADMIN_AUTH_CHALLENGE_TTL_SECONDS=300
ADMIN_AUTH_SESSION_TTL_SECONDS=900
# Browser-visible HTTPS origin in deployment; local HTTP loopback is allowed for development.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8800
# Server-only credentials used by apps/api for loopback workers.
# The funding token must match the value in .env.testnet-funding.
TESTNET_FUNDING_API_TOKEN=
TESTNET_FUNDING_SERVICE_URL=http://127.0.0.1:8790
# Used only by the explicit one-shot and watch operator commands.
OPERATOR_EVIDENCE_PATH=.scratch/base-sepolia-operator.json
OPERATOR_EXECUTE=false
# Used only by pnpm operator:watch; deployed automation invokes the one-shot command from a managed scheduler.
OPERATOR_INTERVAL_SECONDS=300
OPERATOR_MINIMUM_OUTPUT_BPS=9900
# Protocol-Owned Liquidity batching policy; public operational values, not secrets.
OPERATOR_POL_MINIMUM_QUEUE_WETH=0.005
OPERATOR_POL_TARGET_WETH_PER_CYCLE=0.025
OPERATOR_POL_MAXIMUM_WETH_PER_CYCLE=0.05
OPERATOR_POL_STALE_QUEUE_SECONDS=900
# Operator control plane. The watch hosts the loopback surface and the public API is the only
# process allowed to reach it; the browser never holds this token. The watch starts the surface
# only when the host, port, token, and NEXT_PUBLIC_APP_URL are all present, and the API proxies to
# it only when the URL is set. Leave every name blank to run the operator without a control plane.
OPERATOR_CONTROL_HOST=127.0.0.1
OPERATOR_CONTROL_PORT=8795
OPERATOR_CONTROL_URL=http://127.0.0.1:8795
# 32 characters or more, shared by the watch and the API. Never reaches the browser.
OPERATOR_CONTROL_API_TOKEN=
OPERATOR_CONTROL_DATABASE_PATH=/var/lib/orbit/operator-control/operator-control.sqlite
DEPLOYMENT_ENVIRONMENT=staging
# Browser-public web bindings. The guarded launcher projects these from this file into the web
# process; apps/web/.env* is rejected so Next.js never auto-loads an unreviewed value. Every
# NEXT_PUBLIC_ name the web application reads must appear here. NEXT_PUBLIC_RPC_URL takes
# precedence over NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL, which is the staging fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=staging
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=
SELF_FUNDED_TEST_ASSETS=true
DEPLOYER_ADDRESS=
TREASURY_ADDRESS=
CANONICAL_MARKET_REGISTRY_ADDRESS=
GENESIS_LIQUIDITY_VAULT_ADDRESS=
# Deployment-time module governance. Claim eligibility is fixed to current Permanent Collectible
# ownership and has no environment-selectable administrator.
# GOVERNANCE_OWNER_ADDRESS nominates a reviewed multisig for the four mutable modules; ownership
# is two-step, so the deployment leaves the deployer owning them and the multisig must call
# acceptOwnership before governance is actually in place. See docs/operations/module-governance.md,
# docs/operations/claim-policy.md, and ADR 0002.
GOVERNANCE_OWNER_ADDRESS=
# The alternative venues this deployment will refuse to let the liquid token reach. The blocklist
# freezes at launch, so this file is final for the deployment that uses it: anything omitted can
# never be added afterwards. deployments/84532.blocked-venues.json is the reviewed Base Sepolia
# inventory. Leaving this unset blocks only the sealed-route test venue.
BLOCKED_VENUE_INVENTORY_PATH=deployments/84532.blocked-venues.json
# Deployment-time only. Remove it and the combined deployment environment from every runtime host
# after the checked manifest and runtime roles have been verified.
DEPLOYER_PRIVATE_KEY=
# Native wei seeded into the programmatically created Chainlink VRF v2.5 subscription. The
# Base Sepolia default is 0.03 ETH; set a larger buffer for sustained test activity.
VRF_NATIVE_FUNDING_WEI=
# Use OPERATOR_PRIVATE_KEY when one dedicated identity holds both operational roles. For split
# identities, leave it blank and configure both role-specific keys instead. The self-funded
# staging profile may reuse DEPLOYER_PRIVATE_KEY when execute mode is live; the backend maps that
# value only into the operator child. Production never receives this development fallback.
OPERATOR_PRIVATE_KEY=
OPERATOR_KEEPER_PRIVATE_KEY=
OPERATOR_LIQUIDITY_EXECUTOR_PRIVATE_KEY=
RECOVERY_AUTHORITY_ADDRESS=
RECOVERY_COSIGNER_ADDRESS=
GUARDIAN_ADDRESS=
KEEPER_ADDRESS=
LIQUIDITY_EXECUTOR_ADDRESS=
CREATOR_ADDRESS=
