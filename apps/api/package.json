    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@orbit/config": "workspace:*",
    "@orbit/protocol": "workspace:*",
    "effect": "3.22.1",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
