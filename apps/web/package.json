{
  "name": "@orbit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/staging-web.ts dev",
    "dev:local": "node ../../scripts/staging-web.ts dev:local",
    "build": "node ../../scripts/staging-web.ts build",
    "start": "node ../../scripts/staging-web.ts start",
    "test:production": "pnpm test:release",
    "test:browser": "node ../../scripts/staging-web.ts browser",
    "test:browser:self": "node ../../scripts/staging-web.ts browser:self",
    "test:release": "NEXT_PUBLIC_API_URL=http://127.0.0.1:18800 NEXT_PUBLIC_APP_URL=https://orbit.test NEXT_PUBLIC_REOWN_PROJECT_ID=00000000000000000000000000000000 pnpm build && pnpm test:browser",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "typecheck": "node ../../scripts/staging-web.ts typecheck"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@orbit/config": "workspace:*",
    "@orbit/protocol": "workspace:*",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "5.102.5",
    "@tradecanvas/chart": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.55.19",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "axe-core": "4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
